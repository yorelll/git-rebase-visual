{
  "name": "git-rebase-visual",
  "displayName": "Git Rebase Visual",
  "description": "Visual interactive rebase: drag to reorder commits, reword, lock, and AI-generated commit messages.",
  "version": "0.7.1",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorelll/git-rebase-visual.git"
  },
  "license": "MIT",
  "icon": "media/extension-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitRebaseVisual",
          "title": "Git Rebase",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitRebaseVisual": [
        {
          "id": "gitRebaseVisual.commits",
          "name": "Commits"
        }
      ]
    },
    "commands": [
      {
        "command": "gitRebaseVisual.refresh",
        "title": "Refresh",
        "category": "Git Rebase",
        "icon": "$(refresh)"
      },
      {
        "command": "gitRebaseVisual.push",
        "title": "Push",
        "category": "Git Rebase",
        "icon": "$(repo-push)"
      },
      {
        "command": "gitRebaseVisual.stash",
        "title": "Stash Changes",
        "category": "Git Rebase",
        "icon": "$(archive)"
      },
      {
        "command": "gitRebaseVisual.stashPop",
        "title": "Pop Stash",
        "category": "Git Rebase",
        "icon": "$(inbox)"
      },
      {
        "command": "gitRebaseVisual.undo",
        "title": "Undo Last Rewrite",
        "category": "Git Rebase",
        "icon": "$(discard)"
      },
      {
        "command": "gitRebaseVisual.reveal",
        "title": "Show Git Rebase Visual",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.copyHash",
        "title": "Copy Commit Hash",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.copyMessage",
        "title": "Copy Commit Message",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.openDiff",
        "title": "Open Commit Diff…",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.generateDiff",
        "title": "Generate Diff",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.reword",
        "title": "Edit Commit Message…",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.aiMessage",
        "title": "Generate Commit Message…",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.rebaseTo",
        "title": "Stop Here (edit)",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.appendStaged",
        "title": "Append Staged Changes",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.lock",
        "title": "Lock Commit",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.unlock",
        "title": "Unlock Commit",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.drop",
        "title": "Drop Commit",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.squash",
        "title": "Squash into Previous Commit",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.fixup",
        "title": "Fixup into Previous Commit",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.bulkLock",
        "title": "Lock Selected Commits",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.bulkDrop",
        "title": "Drop Selected Commits",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.commit.bulkGenerateDiff",
        "title": "Generate Selected Diff",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.worktree.openDiff",
        "title": "Open Diff",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.worktree.stage",
        "title": "Stage File",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.worktree.restore",
        "title": "Restore File",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.worktree.deleteUntracked",
        "title": "Delete Untracked File",
        "category": "Git Rebase",
        "icon": "$(trash)"
      },
      {
        "command": "gitRebaseVisual.worktree.stageAll",
        "title": "Stage All Changes",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.worktree.discardAll",
        "title": "Discard All Working Changes",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.worktree.unstageAll",
        "title": "Unstage All Changes",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.worktree.stagedAiMessage",
        "title": "Generate Commit Message for Staged Changes…",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.rebase.continue",
        "title": "Continue Rebase",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.rebase.abort",
        "title": "Abort Rebase",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.rebase.skip",
        "title": "Skip Conflicted Commit",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.rebase.editStopAmend",
        "title": "Amend at Edit Stop…",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.rebase.editStopNew",
        "title": "Create Commit at Edit Stop…",
        "category": "Git Rebase"
      },
      {
        "command": "gitRebaseVisual.rebase.editStopDraft",
        "title": "Generate Draft Message at Edit Stop…",
        "category": "Git Rebase"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitRebaseVisual.push",
          "when": "view == gitRebaseVisual.commits",
          "group": "navigation@1"
        },
        {
          "command": "gitRebaseVisual.stash",
          "when": "view == gitRebaseVisual.commits",
          "group": "navigation@2"
        },
        {
          "command": "gitRebaseVisual.stashPop",
          "when": "view == gitRebaseVisual.commits",
          "group": "navigation@3"
        },
        {
          "command": "gitRebaseVisual.undo",
          "when": "view == gitRebaseVisual.commits",
          "group": "navigation@4"
        },
        {
          "command": "gitRebaseVisual.refresh",
          "when": "view == gitRebaseVisual.commits",
          "group": "navigation@5"
        },
        {
          "command": "gitRebaseVisual.rebase.continue",
          "when": "view == gitRebaseVisual.commits",
          "group": "navigation@6"
        },
        {
          "command": "gitRebaseVisual.rebase.abort",
          "when": "view == gitRebaseVisual.commits",
          "group": "navigation@7"
        }
      ],
      "view/item/context": [
        {
          "command": "gitRebaseVisual.commit.copyHash",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "navigation@1"
        },
        {
          "command": "gitRebaseVisual.commit.copyMessage",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "navigation@2"
        },
        {
          "command": "gitRebaseVisual.commit.openDiff",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "navigation@3"
        },
        {
          "command": "gitRebaseVisual.commit.generateDiff",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "navigation@4"
        },
        {
          "command": "gitRebaseVisual.commit.reword",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "edit@1"
        },
        {
          "command": "gitRebaseVisual.commit.aiMessage",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "edit@2"
        },
        {
          "command": "gitRebaseVisual.commit.rebaseTo",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "edit@3"
        },
        {
          "command": "gitRebaseVisual.commit.appendStaged",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "edit@4"
        },
        {
          "command": "gitRebaseVisual.commit.lock",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "edit@5"
        },
        {
          "command": "gitRebaseVisual.commit.unlock",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit.locked",
          "group": "edit@5"
        },
        {
          "command": "gitRebaseVisual.commit.squash",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "edit@6"
        },
        {
          "command": "gitRebaseVisual.commit.fixup",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "edit@7"
        },
        {
          "command": "gitRebaseVisual.commit.drop",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.commit",
          "group": "danger@1"
        },
        {
          "command": "gitRebaseVisual.commit.bulkGenerateDiff",
          "when": "view == gitRebaseVisual.commits && viewItem =~ /gitRebaseVisual\\.commit\\.batch\\.contiguous/",
          "group": "batch@1"
        },
        {
          "command": "gitRebaseVisual.commit.bulkLock",
          "when": "view == gitRebaseVisual.commits && viewItem =~ /gitRebaseVisual\\.commit\\.batch/",
          "group": "batch@2"
        },
        {
          "command": "gitRebaseVisual.commit.bulkDrop",
          "when": "view == gitRebaseVisual.commits && viewItem =~ /gitRebaseVisual\\.commit\\.batch/",
          "group": "danger@2"
        },
        {
          "command": "gitRebaseVisual.worktree.openDiff",
          "when": "view == gitRebaseVisual.commits && (viewItem == gitRebaseVisual.worktree.staged || viewItem == gitRebaseVisual.worktree.working || viewItem == gitRebaseVisual.worktree.untracked)",
          "group": "navigation@1"
        },
        {
          "command": "gitRebaseVisual.worktree.stage",
          "when": "view == gitRebaseVisual.commits && (viewItem == gitRebaseVisual.worktree.working || viewItem == gitRebaseVisual.worktree.untracked)",
          "group": "edit@1"
        },
        {
          "command": "gitRebaseVisual.worktree.restore",
          "when": "view == gitRebaseVisual.commits && (viewItem == gitRebaseVisual.worktree.staged || viewItem == gitRebaseVisual.worktree.working)",
          "group": "edit@2"
        },
        {
          "command": "gitRebaseVisual.worktree.deleteUntracked",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.worktree.untracked",
          "group": "inline@1"
        },
        {
          "command": "gitRebaseVisual.worktree.stageAll",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.worktree.workingSection",
          "group": "navigation@1"
        },
        {
          "command": "gitRebaseVisual.worktree.discardAll",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.worktree.workingSection",
          "group": "danger@1"
        },
        {
          "command": "gitRebaseVisual.worktree.unstageAll",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.worktree.stagedSection",
          "group": "navigation@1"
        },
        {
          "command": "gitRebaseVisual.worktree.stagedAiMessage",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.worktree.stagedSection",
          "group": "edit@1"
        },
        {
          "command": "gitRebaseVisual.rebase.continue",
          "when": "view == gitRebaseVisual.commits && (viewItem == gitRebaseVisual.rebase || viewItem == gitRebaseVisual.editStop)",
          "group": "navigation@1"
        },
        {
          "command": "gitRebaseVisual.rebase.abort",
          "when": "view == gitRebaseVisual.commits && (viewItem == gitRebaseVisual.rebase || viewItem == gitRebaseVisual.editStop)",
          "group": "danger@2"
        },
        {
          "command": "gitRebaseVisual.rebase.skip",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.rebase",
          "group": "danger@1"
        },
        {
          "command": "gitRebaseVisual.rebase.editStopAmend",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.editStop",
          "group": "edit@1"
        },
        {
          "command": "gitRebaseVisual.rebase.editStopNew",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.editStop",
          "group": "edit@2"
        },
        {
          "command": "gitRebaseVisual.rebase.editStopDraft",
          "when": "view == gitRebaseVisual.commits && viewItem == gitRebaseVisual.editStop",
          "group": "edit@3"
        }
      ]
    },
    "configuration": {
      "title": "Git Rebase Visual",
      "properties": {
        "gitRebaseVisual.commitRange": {
          "type": "string",
          "enum": [
            "upstream",
            "mainBranch",
            "recentN",
            "all"
          ],
          "default": "upstream",
          "description": "Which commits to show. upstream: @{upstream}..HEAD; mainBranch: <mainBranch>..HEAD; recentN: last N commits; all: entire branch history."
        },
        "gitRebaseVisual.mainBranch": {
          "type": "string",
          "default": "main",
          "description": "Base branch used when commitRange is 'mainBranch'."
        },
        "gitRebaseVisual.recentCount": {
          "type": "number",
          "default": 20,
          "description": "Number of commits to show when commitRange is 'recentN'."
        },
        "gitRebaseVisual.llm.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API base URL (e.g. https://host/openai-compatible/v1)."
        },
        "gitRebaseVisual.llm.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the OpenAI-compatible endpoint."
        },
        "gitRebaseVisual.llm.model": {
          "type": "string",
          "default": "fast",
          "description": "Model name to use for commit message generation (e.g. fast, expert)."
        },
        "gitRebaseVisual.llm.skillPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a skill markdown file loaded into every LLM request to guide commit message style."
        },
        "gitRebaseVisual.llm.timeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "Maximum time in milliseconds to wait for an LLM response before cancelling it."
        },
        "gitRebaseVisual.diffMaxChars": {
          "type": "number",
          "default": 12000,
          "description": "Maximum characters of a commit diff sent to the LLM before truncation."
        },
        "gitRebaseVisual.push.refspecTemplate": {
          "type": "string",
          "default": "",
          "description": "Optional refspec template for review pushes (e.g. 'HEAD:refs/for/master'). Placeholders: ${tip} (resolves to HEAD), ${branch}. When set, pushing offers a choice between a normal push and this review push. Leave empty for normal branch pushes."
        },
        "gitRebaseVisual.autoStash": {
          "type": "boolean",
          "default": true,
          "description": "When true, automatically stash a dirty working tree before a rebase and restore it after the rebase finishes (or after you Continue/Abort). When false, operations that need a clean tree are blocked with a warning asking you to stash manually."
        },
        "gitRebaseVisual.collapseLockedRuns": {
          "type": "boolean",
          "default": true,
          "description": "Collapse runs of three or more locked commits in the rebase timeline."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/index.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage test/index.test.ts",
    "test:release": "npm run typecheck && npm run test:coverage",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.20.0",
    "jsdom": "^24.1.3",
    "tsx": "^4.20.0",
    "typescript": "^5.4.0"
  }
}
